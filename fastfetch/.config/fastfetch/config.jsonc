{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "sixel",
        "source": "~/.config/fastfetch/logo.png",
        "width": 55,
        "height": 15,
        "padding": {
            "top": 1,
            "left": 2,
            "right": 2
        },
        "recache": true
    },
    "display": {
        "separator": ": ",
        "size": {
            "binaryPrefix": "iec"
        },
        "key": {
            "type": "icon"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "M31",
            "key": " "
        },
        {
            "type": "separator",
            "string": "------------------------"
        },
        {
            "type": "os",
            "key": "os"
        },
        {
            "type": "kernel",
            "key": "kernel"
        },
        {
            "type": "cpu",
            "key": "cpu"
        },
        {
            "type": "gpu",
            "key": "gpu"
        },
        {
            "type": "memory",
            "key": "memory"
        },
        {
            "type": "display",
            "key": "display"
        },
        {
            "type": "terminal",
            "key": "terminal"
        },
        {
            "type": "shell",
            "key": "shell"
        },
        {
            "type": "wm",
            "key": "wm"
        },
        {
            "type": "packages",
            "key": "packages"
        },
        {
            "type": "icons",
            "key": "icons"
        },
        {
            "type": "custom",
            "format": "github.com/WaffleWaldo",
            "key": " "
        },
        "break",
        "colors"
    ]
}
