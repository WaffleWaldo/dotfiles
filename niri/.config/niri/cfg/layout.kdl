    layout {
        gaps 8
        center-focused-column "never"
        always-center-single-column

        background-color "transparent" // <- needed for noctalia-shell to set wallpaper

        focus-ring {
            width 2
            active-color "#FFB000"
            inactive-color "#333333"
        }

        // 1px hairline on EVERY window (focus-ring only wraps the focused one) —
        // the "every panel outlined" look from the inspo
        border {
            on
            width 1
            active-color "#FFB000"
            inactive-color "#333333"
        }

        shadow {
            off
        }

        preset-column-widths {
            proportion 0.25
            proportion 0.5
            proportion 0.75
            proportion 1.0
        }

        default-column-width {
            proportion 0.5
        }

        tab-indicator {
            hide-when-single-tab
            place-within-column
            position "left"
            corner-radius 0.0
            gap -8.0
            gaps-between-tabs 4.0
            width 2.0
            length total-proportion=0.1
        }

        struts {}
    }
