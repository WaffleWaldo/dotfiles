    // Coldwire motion: critically damped (d=1.0), stiff springs — fast, dead-stop, no overshoot.
    // Pre-Coldwire values in git (dotfiles 0f257c0) if this ever feels too abrupt.
    animations {
        workspace-switch {
            spring damping-ratio=1.0 stiffness=1600 epsilon=0.0001
        }
        window-open {
            spring damping-ratio=1.0 stiffness=1600 epsilon=0.0001
        }
        window-close {
            spring damping-ratio=1.0 stiffness=1800 epsilon=0.0001
        }
        horizontal-view-movement {
            spring damping-ratio=1.0 stiffness=1500 epsilon=0.0001
        }
        window-movement {
            spring damping-ratio=1.0 stiffness=1500 epsilon=0.0001
        }
        window-resize {
            spring damping-ratio=1.0 stiffness=1600 epsilon=0.0001
        }
        config-notification-open-close {
            spring damping-ratio=1.0 stiffness=1800 epsilon=0.001
        }
        screenshot-ui-open {
            duration-ms 150
            curve "ease-out-quad"
        }
        overview-open-close {
            spring damping-ratio=1.0 stiffness=1400 epsilon=0.0001
        }
    }
