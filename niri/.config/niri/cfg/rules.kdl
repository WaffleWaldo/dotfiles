    // ─── Default window rule ───
    window-rule {
        geometry-corner-radius 0
        clip-to-geometry true
        draw-border-with-background false
    }

    // ─── Screencast target highlight (red = recording, per Coldwire semantics) ───
    window-rule {
        match is-window-cast-target=true
        focus-ring {
            active-color "#FF3B30"
            inactive-color "#7A1D17"
        }
        border {
            inactive-color "#7A1D17"
        }
        tab-indicator {
            active-color "#FF3B30"
            inactive-color "#7A1D17"
        }
    }

    // ─── Block messaging apps from screencast ───
    window-rule {
        match app-id="org.telegram.desktop"
        block-out-from "screencast"
    }

    // ─── Browser scroll factor ───
    window-rule {
        match app-id="zen"
        match app-id="firefox"
        match app-id="chromium-browser"
        match app-id="google-chrome"
        match app-id="xdg-desktop-portal-gtk"
        scroll-factor 0.6
    }

    // ─── Browsers open maximized ───
    window-rule {
        match app-id="zen"
        match app-id="firefox"
        match app-id="chromium-browser"
        match app-id="google-chrome"
        open-maximized true
    }

    // ─── Picture-in-Picture ───
    window-rule {
        match title="^Picture-in-Picture$"
        open-floating true
        default-floating-position x=32 y=32 relative-to="bottom-right"
        default-column-width { fixed 480; }
        default-window-height { fixed 270; }
    }

    // ─── Discord Popout ───
    window-rule {
        match title="Discord Popout"
        open-floating true
        default-floating-position x=32 y=32 relative-to="bottom-right"
    }

    // ─── Float: audio/volume controls ───
    window-rule {
        match app-id="pavucontrol"
        match app-id="pavucontrol-qt"
        match app-id="com.saivert.pwvucontrol"
        open-floating true
    }

    // ─── Float: dialogs & utilities ───
    window-rule {
        match app-id="dialog"
        match app-id="popup"
        match app-id="task_dialog"
        match app-id="gcr-prompter"
        match app-id="pinentry"
        match app-id="file-roller"
        match app-id="org.gnome.FileRoller"
        match app-id="nm-connection-editor"
        match app-id="blueman-manager"
        match app-id="xdg-desktop-portal-gtk"
        match app-id="org.kde.polkit-kde-authentication-agent-1"
        open-floating true
    }

    // ─── Float: common dialog titles ───
    window-rule {
        match title="Progress"
        match title="File Operations"
        match title="Confirm"
        match title="Error"
        open-floating true
    }

    // ─── Vesktop (Discord) transparency ───
    window-rule {
        match app-id="vesktop"
        opacity 0.92
    }

    // ─── Obsidian transparency ───
    window-rule {
        match app-id="obsidian"
        opacity 0.96
    }

    // ─── VS Code transparency ───
    window-rule {
        match app-id="code"
        opacity 0.92
    }

    // ─── Steam games: force true fullscreen (niri tiles fullscreen requests by default) ───
    window-rule {
        match app-id=r#"^steam_app_\d+$"#
        open-fullscreen true
        default-column-width { proportion 1.0; }
    }

    // ─── Noctalia wallpaper layer ───
    layer-rule {
        match namespace="^noctalia-wallpaper*"
        place-within-backdrop true
    }
